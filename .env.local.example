# Any long random string — used to sign the session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Supabase, used as plain Postgres + REST -- not Supabase Auth,
# since login already works via the session-cookie system above).
# Get these from your Supabase project: Settings -> API.
# Use the "service_role" key, NOT the anon/public key -- this app never
# talks to Supabase from the browser, only from server-side route handlers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts OAuth tokens before they're stored in the database. Generate
# with: openssl rand -base64 32
# Deliberately separate from SESSION_SECRET -- see lib/secretCrypto.js.
ENCRYPTION_KEY=

# Gmail SMTP for sending OTP codes. Use a Google App Password, not your
# regular password: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Filled in later, once you register apps with each platform (see README).
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
